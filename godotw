#!/bin/sh
# Local convenience wrapper; GODOT_BIN can select another Godot installation.
set -eu
ALPINE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${GODOT_BIN:-}" ]; then
    ALPINE_ENGINE=$GODOT_BIN
elif command -v godot >/dev/null 2>&1; then
    ALPINE_ENGINE=$(command -v godot)
elif command -v godot4 >/dev/null 2>&1; then
    ALPINE_ENGINE=$(command -v godot4)
elif [ -x /Applications/Godot.app/Contents/MacOS/Godot ]; then
    ALPINE_ENGINE=/Applications/Godot.app/Contents/MacOS/Godot
elif [ -x "$ALPINE_ROOT/.tools/Godot.app/Contents/MacOS/Godot" ]; then
    ALPINE_ENGINE="$ALPINE_ROOT/.tools/Godot.app/Contents/MacOS/Godot"
else
    echo 'Godot 4.7+ was not found. Set GODOT_BIN or open project.godot in Godot.' >&2
    exit 1
fi
# A windowed run launched as a plain exec'd process never gets window-server
# focus on macOS: the window stays occluded, so the main thread blocks ~1s/frame
# in CAMetalLayer nextDrawable and any FPS measured is invalid. `open` launches
# through LaunchServices and focuses the window normally, so route non-headless
# runs through it when the resolved engine is an app bundle.
case " $* " in
    *' --headless '*|*' -s '*|*' --script '*) ALPINE_HEADLESS=1 ;;
    *) ALPINE_HEADLESS= ;;
esac

if [ "$(uname -s)" = "Darwin" ] && [ -z "$ALPINE_HEADLESS" ]; then
    case "$ALPINE_ENGINE" in
        */Contents/MacOS/*)
            ALPINE_BUNDLE=${ALPINE_ENGINE%/Contents/MacOS/*}
            exec open -n -W -a "$ALPINE_BUNDLE" --args --path "$ALPINE_ROOT" "$@"
            ;;
    esac
fi

exec "$ALPINE_ENGINE" --path "$ALPINE_ROOT" "$@"
