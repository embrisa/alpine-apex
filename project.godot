; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Alpine Apex"
run/main_scene="res://startup.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.027451, 0.0784314, 0.129412, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=3
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor]

import/use_multiple_threads=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg", "res://addons/generation_export/plugin.cfg")

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true
buffering/use_accumulated_input=false

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=24
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=32
jolt_physics_3d/simulation/position_steps=12

[shader_globals]

cloud_camera_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cloud_layer_height_m={
"type": "float",
"value": 2400.0
}
cloud_params={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cloud_sun_direction={
"type": "vec3",
"value": Vector3(-0.775, 0.407, 0.484)
}

snow_ambient_top={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
snow_ambient_horizon={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=2048
global_illumination/gi/use_half_resolution=true
anti_aliasing/quality/msaa_3d=1
limits/global_shader_variables/buffer_size=262144
